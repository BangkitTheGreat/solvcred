# Copy to apps/web/.env.local and adjust. All values are public (embedded in the static build).

# Program ID produced by `anchor keys sync` / deploy. Empty = placeholder (not deployed).
VITE_SOLVCRED_PROGRAM_ID=

# Devnet JSON-RPC endpoint. The URL should contain "devnet" so wallets route signed transactions to Devnet.
VITE_SOLVCRED_RPC_URL=https://api.devnet.solana.com

# Genesis hash the RPC must report; protects against a misconfigured endpoint on another cluster.
VITE_SOLVCRED_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
